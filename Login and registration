<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BDBUS Official Website</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f4f7f6; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 40px 20px; position: relative; }
        
        /* ওয়াটারমার্ক */
        .watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 70%; max-width: 500px; opacity: 0.05; pointer-events: none; z-index: 0; }
        
        /* ভাষা সেটিং */
        .lang-container { position: absolute; top: 20px; right: 20px; z-index: 10; font-weight: bold; }
        .lang-btn { cursor: pointer; color: #333; text-decoration: none; padding: 5px; }
        .lang-btn.active { color: #ff5722; }

        /* মেইন কার্ড */
        .form-card { background: rgba(255, 255, 255, 0.95); padding: 40px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 450px; text-align: center; z-index: 5; position: relative; display: none; }
        .form-card.active { display: block; } /* যেটা একটিভ থাকবে সেটা দেখাবে */
        
        .logo { width: 70px; margin-bottom: 12px; }
        h1 { font-size: 19px; color: #1a1a1a; margin-bottom: 5px; font-weight: bold; }
        h2 { font-size: 14px; color: #555; margin-bottom: 20px; letter-spacing: 1px; }
        .form-title { font-size: 20px; font-weight: bold; color: #333; margin: 15px 0 20px 0; border-bottom: 2px solid #ff5722; padding-bottom: 6px; }
        
        /* ইনপুট গ্রুপ */
        .input-group { margin-bottom: 18px; text-align: left; position: relative; }
        .input-group label { display: block; margin-bottom: 6px; font-size: 14px; color: #333; font-weight: 600; }
        .input-group input, .input-group select { width: 100%; padding: 11px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px; outline: none; }
        .input-group input:focus, .input-group select:focus { border-color: #ff5722; }
        
        /* পাসওয়ার্ড শো/হাইড */
        .toggle-password { position: absolute; right: 12px; top: 36px; cursor: pointer; color: #666; font-size: 13px; user-select: none; }
        
        .forget-pwd { display: block; text-align: right; font-size: 13px; color: #ff5722; text-decoration: none; margin-bottom: 20px; }
        
        /* বাটন ও লিংক সমূহ */
        .btn-group { display: flex; gap: 10px; }
        .btn { flex: 1; padding: 12px; border: none; border-radius: 5px; font-size: 15px; font-weight: bold; cursor: pointer; text-decoration: none; transition: 0.3s; text-align: center; }
        .btn-login { background-color: #ff5722; color: white; }
        .btn-login:hover { background-color: #e64a19; }
        .btn-register { background-color: #e0e0e0; color: #333; }
        .btn-register:hover { background-color: #d5d5d5; }
        
        .btn-submit { width: 100%; padding: 12px; border: none; border-radius: 5px; font-size: 16px; font-weight: bold; background-color: #ff5722; color: white; cursor: pointer; transition: 0.3s; }
        .btn-submit:hover { background-color: #e64a19; }
        
        .checkbox-group { display: flex; align-items: flex-start; gap: 10px; text-align: left; margin: 20px 0; }
        .checkbox-group input { margin-top: 3px; width: auto; cursor: pointer; }
        .checkbox-group label { font-size: 13px; color: #555; cursor: pointer; }
        
        .switch-link { display: block; margin-top: 15px; font-size: 14px; color: #666; text-decoration: none; cursor: pointer; }
        .switch-link:hover { color: #ff5722; }
    </style>
</head>
<body>

    <!-- ওয়াটারমার্ক লোগো (ব্যাকগ্রাউন্ড) -->
    <img src="images/BDBUS Group Official Logo.png" alt="BDBUS Watermark" class="watermark">

    <!-- ভাষা পরিবর্তনকারী (সবার জন্য একই জায়গায় ফিক্সড) -->
    <div class="lang-container">
        <span id="lang-en" class="lang-btn active" onclick="changeLang('en')">EN</span> | 
        <span id="lang-bn" class="lang-btn" onclick="changeLang('bn')">বাংলা</span>
    </div>

    <!-- ================= লগইন ফর্ম কার্ড ================= -->
    <div id="loginCard" class="form-card active">
        <img src="images/BDBUS Group Official Logo.png" alt="BDBUS Logo" class="logo">
        <h1 class="txt-main-title">Bangladesh Bussid Unique Society</h1>
        <h2 class="txt-subtitle">BDBUS OFFICIAL WEBSITE</h2>

        <form onsubmit="event.preventDefault(); alert('Login feature is under development.');">
            <div class="input-group">
                <label class="lbl-email" for="loginEmail">Email Address</label>
                <input type="email" id="loginEmail" placeholder="example@email.com" required>
            </div>
            
            <div class="input-group">
                <label class="lbl-pass" for="loginPassword">Password</label>
                <input type="password" id="loginPassword" required>
                <span class="toggle-password" id="txt-toggle" onclick="togglePassword()">Show</span>
            </div>

            <a href="#" class="forget-pwd" id="txt-forget">Forget password?</a>

            <div class="btn-group">
                <button type="submit" class="btn btn-login" id="btn-login">Login Now</button>
                <button type="button" class="btn btn-register" id="btn-register" onclick="switchForm('register')">Registration Now</button>
            </div>
        </form>
    </div>


    <!-- ================= রেজিস্ট্রেশন ফর্ম কার্ড ================= -->
    <div id="registerCard" class="form-card">
        <img src="images/BDBUS Group Official Logo.png" alt="BDBUS Logo" class="logo">
        <h1 class="txt-main-title">Bangladesh Bussid Unique Society</h1>
        <div class="form-title" id="txt-form-title">BDBUS Registration Form</div>

        <form id="regForm" onsubmit="submitForm(event)">
            <div class="input-group">
                <label id="lbl-name" for="fullName">Full Name</label>
                <input type="text" id="fullName" required>
            </div>
            
            <div class="input-group">
                <label id="lbl-nick" for="gameId">Game Nickname / ID</label>
                <input type="text" id="gameId" required>
            </div>

            <div class="input-group">
                <label id="lbl-dob" for="dob">Date of Birth</label>
                <input type="date" id="dob" required>
            </div>

            <div class="input-group">
                <label id="lbl-mobile" for="mobile">Mobile Number</label>
                <input type="tel" id="mobile" required>
            </div>

            <div class="input-group">
                <label id="lbl-gender" for="gender">Gender</label>
                <select id="gender" required>
                    <option value="" disabled selected id="opt-gender">Select Gender</option>
                    <option value="Male" id="opt-male">Male</option>
                    <option value="Female" id="opt-female">Female</option>
                    <option value="Other" id="opt-other">Other</option>
                </select>
            </div>

            <div class="input-group">
                <label id="lbl-div" for="division">Division</label>
                <select id="division" onchange="updateDistricts()" required>
                    <option value="" disabled selected id="opt-div">Select Division</option>
                </select>
            </div>

            <div class="input-group">
                <label id="lbl-dist" for="district">District</label>
                <select id="district" required>
                    <option value="" disabled selected id="opt-dist">Select District</option>
                </select>
            </div>

            <div class="input-group">
                <label id="lbl-fb" for="fbLink">Facebook Profile Link</label>
                <input type="url" id="fbLink" placeholder="https://facebook.com/..." required>
            </div>

            <div class="input-group">
                <label class="lbl-email" for="regEmail">Email Address</label>
                <input type="email" id="regEmail" required>
            </div>

            <div class="input-group">
                <label class="lbl-pass" for="regPassword">Set Password</label>
                <input type="password" id="regPassword" required>
            </div>

            <div class="input-group">
                <label id="lbl-conf" for="confirmPassword">Confirm Password</label>
                <input type="password" id="confirmPassword" required>
            </div>

            <div class="checkbox-group">
                <input type="checkbox" id="declaration" required>
                <label id="lbl-dec" for="declaration">All data is correct declaration check.</label>
            </div>

            <button type="submit" class="btn-submit" id="btn-submit">Registration Submit</button>
            <a class="switch-link" id="lnk-back" onclick="switchForm('login')">Back to Login</a>
        </form>
    </div>

    <script>
        // ফর্ম পরিবর্তন করার ফাংশন
        function switchForm(formType) {
            if(formType === 'register') {
                document.getElementById('loginCard').classList.remove('active');
                document.getElementById('registerCard').classList.add('active');
            } else {
                document.getElementById('registerCard').classList.remove('active');
                document.getElementById('loginCard').classList.add('active');
            }
            window.scrollTo(0, 0); // পেজের একদম উপরে নিয়ে যাওয়ার জন্য
        }

        // পাসওয়ার্ড শো/হাইড ফাংশন
        function togglePassword() {
            var pwdInput = document.getElementById("loginPassword");
            var toggleText = document.getElementById("txt-toggle");
            var currentLang = document.getElementById("lang-bn").classList.contains("active") ? 'bn' : 'en';

            if (pwdInput.type === "password") {
                pwdInput.type = "text";
                toggleText.innerText = currentLang === 'bn' ? "লুকান" : "Hide";
            } else {
                pwdInput.type = "password";
                toggleText.innerText = currentLang === 'bn' ? "দেখান" : "Show";
            }
        }

        // বাংলাদেশ বিভাগ ও জেলা ডেটাবেজ
        const bdData = {
            "Dhaka": ["Dhaka", "Gazipur", "Narayanganj", "Tangail", "Faridpur", "Gopalganj", "Kishoreganj", "Madaripur", "Manikganj", "Munshiganj", "Narsingdi", "Rajbari", "Shariatpur"],
            "Chattogram": ["Chattogram", "Cox's Bazar", "Cumilla", "Feni", "Brahmanbaria", "Chandpur", "Noakhali", "Lakshmipur", "Rangamati", "Khagrachhari", "Bandarban"],
            "Rajshahi": ["Rajshahi", "Bogra", "Pabna", "Natore", "Naogaon", "Chapai Nawabganj", "Joypurhat", "Sirajganj"],
            "Khulna": ["Khulna", "Jashore", "Satkhira", "Bagerhat", "Kushtia", "Meherpur", "Chuadanga", "Jhenaidah", "Magura", "Narail"],
            "Barishal": ["Barishal", "Bhola", "Patuakhali", "Pirojpur", "Jhalokathi", "Barguna"],
            "Sylhet": ["Sylhet", "Moulvibazar", "Habiganj", "Sunamganj"],
            "Rangpur": ["Rangpur", "Dinajpur", "Kurigram", "Gaibandha", "Nilphamari", "Panchagarh", "Thakurgaon", "Lalmonirhat"],
            "Mymensingh": ["Mymensingh", "Jamalpur", "Netrokona", "Sherpur"]
        };

        const bdDataBn = {
            "ঢাকা": ["ঢাকা", "গাজীপুর", "নারায়ণগঞ্জ", "টাঙ্গাইল", "ফরিদপুর", "গোপালগঞ্জ", "কিশোরগঞ্জ", "مাদারীপুর", "মানিকগঞ্জ", "মুন্সীগঞ্জ", "নরসিংদী", "রাজবাড়ী", "শরীয়তপুর"],
            "চট্টগ্রাম": ["চট্টগ্রাম", "কক্সবাজার", "কুমিল্লা", "ফেনী", "ব্রাহ্মণবাড়িয়া", "চাঁদপুর", "নোয়াখালী", "লক্ষ্মীপুর", "রাঙ্গামাটি", "খাগড়াছড়ি", "বান্দরবান"],
            "রাজশাহী": ["রাজশাহী", "বগুড়া", "পাবনা", "নাটোর", "নওগাঁ", "চাঁপাইনবাবগঞ্জ", "জয়পুরহাট", "সিরাজগঞ্জ"],
            "খুলনা": ["খুলনা", "যশোর", "সাতক্ষীরা", "বাগেরহাট", "কুষ্টিয়া", "মেহেরপুর", "চুয়াডাঙ্গা", "ঝিনাইদহ", "মাগুরা", "নড়াইল"],
            "বরিশাল": ["বরিশাল", "ভোলা", "পটুয়াখালী", "পিরোজপুর", "ঝালকাঠি", "বরগুনা"],
            "সিলেট": ["সিলেট", "মৌলভীবাজার", "হবিগঞ্জ", "সুনামগঞ্জ"],
            "রংপুর": ["রংপুর", "দিনাজপুর", "কুড়িগ্রাম", "গাইবান্ধা", "নীলফামারী", "পঞ্চগড়", "ঠাকুরগাঁও", "লালমনিরহাট"],
            "ময়মনসিংহ": ["ময়মনসিংহ", "জামালপুর", "নেত্রকোনা", "শেরপুর"]
        };

        function populateDivisions(lang) {
            const divSelect = document.getElementById("division");
            const currentVal = divSelect.value;
            divSelect.innerHTML = `<option value="" disabled selected>${lang === 'bn' ? 'বিভাগ নির্বাচন করুন' : 'Select Division'}</option>`;
            
            const data = lang === 'bn' ? bdDataBn : bdData;
            Object.keys(data).forEach(div => {
                let opt = document.createElement("option");
                opt.value = div;
                opt.innerText = div;
                divSelect.appendChild(opt);
            });
            if(currentVal) divSelect.value = currentVal;
        }

        function updateDistricts() {
            const divSelect = document.getElementById("division").value;
            const distSelect = document.getElementById("district");
            const currentLang = document.getElementById("lang-bn").classList.contains("active") ? 'bn' : 'en';
            
            distSelect.innerHTML = `<option value="" disabled selected>${currentLang === 'bn' ? 'জেলা নির্বাচন করুন' : 'Select District'}</option>`;
            
            const data = currentLang === 'bn' ? bdDataBn : bdData;
            if(divSelect && data[divSelect]) {
                data[divSelect].forEach(dist => {
                    let opt = document.createElement("option");
                    opt.value = dist;
                    opt.innerText = dist;
                    distSelect.appendChild(opt);
                });
            }
        }

        // ডিফল্ট ইংরেজি লোড
        populateDivisions('en');

        // ভাষা পরিবর্তনের মূল ফাংশন (উভয় ফর্মের ভাষা একসাথে পরিবর্তন হবে)
        function changeLang(lang) {
            var enBtn = document.getElementById("lang-en");
            var bnBtn = document.getElementById("lang-bn");
            var toggleText = document.getElementById("txt-toggle");
            var pwdInput = document.getElementById("loginPassword");

            var mainTitles = document.getElementsByClassName("txt-main-title");
            var emailLabels = document.getElementsByClassName("lbl-email");
            var passLabels = document.getElementsByClassName("lbl-pass");

            if(lang === 'en') {
                enBtn.classList.add("active");
                bnBtn.classList.remove("active");
                
                for(let el of mainTitles) el.innerText = "Bangladesh Bussid Unique Society";
                for(let el of emailLabels) el.innerText = "Email Address";
                for(let el of passLabels) el.innerText = "Password";
                
                document.getElementById("txt-subtitle").innerText = "BDBUS OFFICIAL WEBSITE";
                document.getElementById("txt-forget").innerText = "Forget password?";
                document.getElementById("btn-login").innerText = "Login Now";
                document.getElementById("btn-register").innerText = "Registration Now";
                toggleText.innerText = pwdInput.type === "password" ? "Show" : "Hide";

                // রেজিস্ট্রেশন সেকশন
                document.getElementById("txt-form-title").innerText = "BDBUS Registration Form";
                document.getElementById("lbl-name").innerText = "Full Name";
                document.getElementById("lbl-nick").innerText = "Game Nickname / ID";
                document.getElementById("lbl-dob").innerText = "Date of Birth";
                document.getElementById("lbl-mobile").innerText = "Mobile Number";
                document.getElementById("lbl-gender").innerText = "Gender";
                document.getElementById("opt-gender").innerText = "Select Gender";
                document.getElementById("opt-male").innerText = "Male";
                document.getElementById("opt-female").innerText = "Female";
                document.getElementById("opt-other").innerText = "Other";
                document.getElementById("lbl-div").innerText = "Division";
                document.getElementById("lbl-dist").innerText = "District";
                document.getElementById("lbl-fb").innerText = "Facebook Profile Link";
                document.getElementById("lbl-conf").innerText = "Confirm Password";
                document.getElementById("lbl-dec").innerText = "All data is correct declaration check.";
                document.getElementById("btn-submit").innerText = "Registration Submit";
                document.getElementById("lnk-back").innerText = "Back to Login";
                
                populateDivisions('en');
                updateDistricts();
            } else {
                bnBtn.classList.add("active");
                enBtn.classList.remove("active");
                
                for(let el of mainTitles) el.innerText = "বাংলাদেশ বাসআইডি ইউনিক সোসাইটি";
                for(let el of emailLabels) el.innerText = "ইমেইল এড্রেস";
                for(let el of passLabels) el.innerText = "পাসওয়ার্ড";
                
                document.getElementById("txt-subtitle").innerText = "বিডিবাস অফিসিয়াল ওয়েবসাইট";
                document.getElementById("txt-forget").innerText = "পাসওয়ার্ড ভুলে গেছেন?";
                document.getElementById("btn-login").innerText = "লগইন করুন";
                document.getElementById("btn-register").innerText = "নিবন্ধন করুন";
                toggleText.innerText = pwdInput.type === "password" ? "দেখান" : "লুকান";

                // রেজিস্ট্রেশন সেকশন
                document.getElementById("txt-form-title").innerText = "BDBUS রেজিস্ট্রেশন ফর্ম";
                document.getElementById("lbl-name").innerText = "পূর্ণ নাম";
                document.getElementById("lbl-nick").innerText = "গেম নিকনেম / আইডি";
                document.getElementById("lbl-dob").innerText = "জন্ম তারিখ";
                document.getElementById("lbl-mobile").innerText = "মোবাইল নম্বর";
                document.getElementById("lbl-gender").innerText = "লিঙ্গ";
                document.getElementById("opt-gender").innerText = "লিঙ্গ নির্বাচন করুন";
                document.getElementById("opt-male").innerText = "পুরুষ";
                document.getElementById("opt-female").innerText = "মহিলা";
                document.getElementById("opt-other").innerText = "অন্যান্য";
                document.getElementById("lbl-div").innerText = "বিভাগ";
                document.getElementById("lbl-dist").innerText = "জেলা";
                document.getElementById("lbl-fb").innerText = "ফেসবুক প্রোফাইল লিংক";
                document.getElementById("lbl-conf").innerText = "পাসওয়ার্ড নিশ্চিত করুন";
                document.getElementById("lbl-dec").innerText = "সব তথ্য সঠিক আছে তা নিশ্চিত করুন।";
                document.getElementById("btn-submit").innerText = "রেজিস্ট্রেশন সাবমিট করুন";
                document.getElementById("lnk-back").innerText = "লগইন পেজে ফিরে যান";
                
                populateDivisions('bn');
                updateDistricts();
            }
        }

        // ফর্ম সাবমিশন ও ভ্যালিডেশন
        function submitForm(e) {
            e.preventDefault();
            const pass = document.getElementById("regPassword").value;
            const confPass = document.getElementById("confirmPassword").value;
            const currentLang = document.getElementById("lang-bn").classList.contains("active") ? 'bn' : 'en';

            if(pass !== confPass) {
                alert(currentLang === 'bn' ? "পাসওয়ার্ড মেলেনি!" : "Passwords do not match!");
                return;
            }

            alert(currentLang === 'bn' ? "রেজিস্ট্রেশন সাকসেসফুল।" : "Registration Successful.");
            document.getElementById("regForm").reset();
            switchForm('login'); // সাকসেসফুল হলে আবার লগইন ফর্মে নিয়ে যাবে
        }
    </script>
</body>
</html>
